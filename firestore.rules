rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin"; }
    match /admins/{uid} { allow read, write: if signedIn() && request.auth.uid == uid; }
    match /{document=**} { allow read, write: if isAdmin(); }
  }
}
